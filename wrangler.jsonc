{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "binding": "ASSETS",
    // Unknown paths (e.g. /about) fall back to index.html so deep links open windows.
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker first. It is the log-on gate: nothing from the built
    // site is served until the visitor holds a session cookie (see worker/index.ts).
    "run_worker_first": true
  },
  // The site lives at trentgibson.com. A custom domain makes Cloudflare create the DNS record and certificate on
  // deploy, but only if that name has no DNS record of its own already.
  "routes": [{ "pattern": "trentgibson.com", "custom_domain": true }],
  "vars": {
    // Public. The real Turnstile widget's sitekey (local dev uses the dummy key from .dev.vars).
    // The matching secret is NOT stored here: see .dev.vars.example.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGEFxsVhertb8qWj"
  },
  // Storage. D1 is the database (items, purchases); R2 holds the wishlist's pictures. Both are free at this
  // size. Locally they run in memory-on-disk under .wrangler/ and need no setup beyond `npm run db:migrate`.
  // Before deploying, create them and put the real id here (see "Going live" in the README):
  //   npx wrangler d1 create tgos      then copy its database_id
  //   npx wrangler r2 bucket create tgos-images
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tgos",
      "database_id": "79b30420-ff66-4df8-b5be-b0af438cdaf1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "tgos-images" }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
